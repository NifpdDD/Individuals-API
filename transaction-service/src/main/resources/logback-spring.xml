<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration>

<configuration scan="true">

    <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>

    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- Мы ищем стандартные ключи Micrometer (%X{traceId}), но выводим их в JSON-поле "trace_id" -->
            <pattern>{"timestamp":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}", "trace_id": "%X{traceId:-}", "span_id":"%X{spanId:-}", "transaction_id":"%X{transactionId:-}", "level":"%level", "thread":"%thread", "logger":"%logger{36}","message":"%msg"}%n
            </pattern>
        </encoder>
    </appender>

    <root>
        <level value="INFO"/>
        <appender-ref ref="console"/>
    </root>

</configuration>